{
  "name": "chouyu",
  "version": "1.1.9",
  "description": "Desktop AI pet assistant",
  "author": "cone387",
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cone387/ChouYu.git"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --win",
    "package:win": "electron-vite build && electron-builder --win",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:all": "electron-vite build && electron-builder --mac --win",
    "publish": "electron-vite build && electron-builder --mac --win --publish always",
    "postinstall": "electron-builder install-app-deps",
    "test": "vitest --run",
    "test:smoke": "npm run build && npm run test:smoke:built",
    "test:smoke:built": "node scripts/smoke-electron.js",
    "test:smoke:packaged": "node scripts/smoke-electron.js --packaged dist/win-unpacked/ChouYu.exe",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "fast-check": "^3.23.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  }
}
