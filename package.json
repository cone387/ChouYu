{
  "name": "chouyu",
  "version": "1.3.2",
  "description": "Desktop AI pet assistant",
  "author": "cone387",
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cone387/ChouYu.git"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --win",
    "package:win": "electron-vite build && electron-builder --win",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:all": "electron-vite build && electron-builder --mac --win",
    "publish": "electron-vite build && electron-builder --mac --win --publish always",
    "postinstall": "node scripts/install-electron.js",
    "test": "vitest --run",
    "test:journal-retrieval": "node scripts/evaluate-journal-retrieval.cjs",
    "test:memory-eval": "node scripts/evaluate-memory.mjs",
    "test:journal-soak": "node scripts/journal-soak.cjs",
    "test:smoke": "npm run build && npm run test:smoke:built",
    "test:smoke:built": "node scripts/smoke-electron.js",
    "test:smoke:ocr": "npm run build && node scripts/smoke-electron.js --ocr",
    "test:smoke:packaged": "node scripts/smoke-electron.js --packaged dist/win-unpacked/ChouYu.exe",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fast-check": "^3.23.2",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "@types/node": "^24.0.0"
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
